# ERP connection (server-only: never prefix these with NEXT_PUBLIC_).
ERP_API_URL=https://erp.example.com
# Shared HMAC secret for signing storefront requests. Placeholder only.
STOREFRONT_SIGNING_SECRET=change-me
# The customer-facing hostname the ERP resolves the store from. REQUIRED for all ERP calls
# (cached reads cannot read request headers). Production sets this to the live domain;
# local dev uses a domain registered in the ERP. Without it the Contact form is unavailable.
ERP_STOREFRONT_HOST=localhost
# Where catalogue/nav/contact data come from: "local" (default, bundled data) or "erp".
CATALOGUE_SOURCE=local
# Base URL(s) the ERP serves product images from (its PUBLIC_DISK_URL), comma-separated.
# Allowed as next/image hosts. Read at build time: changing it needs a rebuild / dev restart.
ERP_MEDIA_URL=https://media.zionankara.com
